#: src/configpage.cpp:74
#, kde-format
msgid "GitHub"
msgstr "GitHub"

#: src/configpage.cpp:75
#, kde-format
msgid "Match editor / system theme"
msgstr "В соответствии с темой редактора / системы"

#: src/configpage.cpp:76
#, kde-format
msgid "Style:"
msgstr "Стиль:"

#: src/configpage.cpp:79
#, kde-format
msgid "Follow system (auto)"
msgstr "Как в системе (автоматически)"

#: src/configpage.cpp:80
