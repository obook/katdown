#, kde-format
msgid "Match editor / system theme"
msgstr "Ταίριασμα με το θέμα επεξεργαστή / συστήματος"

#: src/configpage.cpp:76
#, kde-format
msgid "Style:"
msgstr "Στιλ:"

#: src/configpage.cpp:79
#, kde-format
msgid "Follow system (auto)"
msgstr "Ακολούθηση συστήματος (αυτόματα)"

#: src/configpage.cpp:80
#, kde-format
