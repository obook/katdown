#: src/configpage.cpp:85
#, kde-format
msgid ""
"\"GitHub\" uses GitHub's own colors. \"Match editor / system theme\" "
"recolors the same layout from the active editor theme, so the preview blends "
"with the rest of Kate."
msgstr ""
"\"GitHub\" kasutab GitHubi enda värve. \"Järgi redaktori / süsteemi teemat\" "
"värvib sama paigutuse redaktori aktiivse teema järgi, nii et eelvaatlus "
"sobitub ülejäänud Katega."

