#: src/configpage.cpp:85
#, kde-format
msgid ""
"\"GitHub\" uses GitHub's own colors. \"Match editor / system theme\" "
"recolors the same layout from the active editor theme, so the preview blends "
"with the rest of Kate."
msgstr ""
"\"GitHub\" používa vlastné farby GitHubu. \"Podľa témy editora / systému\" "
"zafarbí rovnaké rozloženie podľa aktívnej témy editora, takže náhľad ladí so "
"zvyškom aplikácie Kate."

