#: src/configpage.cpp:74
#, kde-format
msgid "GitHub"
msgstr "GitHub"

#: src/configpage.cpp:75
#, kde-format
msgid "Match editor / system theme"
msgstr "संपादक / सिस्टम थीम से मिलाएँ"

#: src/configpage.cpp:76
#, kde-format
msgid "Style:"
msgstr "शैली:"

#: src/configpage.cpp:79
#, kde-format
msgid "Follow system (auto)"
msgstr "सिस्टम के अनुसार (स्वचालित)"

#: src/configpage.cpp:80
#, kde-format
msgid "Light"
msgstr "हल्का"

#: src/configpage.cpp:81
#, kde-format
msgid "Dark"
msgstr "गहरा"

#: src/configpage.cpp:82
#, kde-format
msgid "GitHub variant:"
msgstr "GitHub प्रकार:"

#: src/configpage.cpp:85
#, kde-format
msgid ""
"\"GitHub\" uses GitHub's own colors. \"Match editor / system theme\" "
"recolors the same layout from the active editor theme, so the preview blends "
"with the rest of Kate."
msgstr ""
"\"GitHub\" में GitHub के अपने रंगों का उपयोग होता है। \"संपादक / सिस्टम थीम से मिलाएँ\" "
"उसी लेआउट को सक्रिय संपादक थीम के रंगों में रंग देता है, ताकि पूर्वावलोकन Kate के बाकी "
"हिस्सों के साथ घुल-मिल जाए।"

#: src/configpage.cpp:97 src/previewwidget.cpp:203
#, kde-format
msgid "Load media previews from remote URLs"
msgstr "रिमोट URL से मीडिया पूर्वावलोकन लोड करें"

#: src/configpage.cpp:100
#, kde-format
msgid ""
"Off by default so the preview stays fully offline. Enable to let images load "
"over http(s)."
msgstr ""
"डिफ़ॉल्ट रूप से बंद, ताकि पूर्वावलोकन पूरी तरह ऑफ़लाइन रहे। छवियों को http(s) से लोड होने "
"देने के लिए सक्षम करें।"

#: src/configpage.cpp:105
#, kde-format
msgid "Math macros:"
msgstr "गणित मैक्रो:"

#: src/configpage.cpp:111
#, kde-format
msgid ""
"The \\newcommand lines written here are available in the formulas of every "
"document."
msgstr "यहाँ लिखी गई \\newcommand पंक्तियाँ हर दस्तावेज़ के सूत्रों में उपलब्ध रहती हैं।"

#: src/configpage.cpp:123
#, kde-format
msgid "Check for updates"
msgstr "अद्यतन के लिए जाँचें"

#: src/configpage.cpp:126
#, kde-format
msgid "Installed version: %1"
msgstr "संस्थापित संस्करण: %1"

#: src/configpage.cpp:136 src/configpage.cpp:141 src/pluginview.cpp:49
#, kde-format
msgid "Katemark"
msgstr "Katemark"

#: src/configpage.cpp:158
#, kde-format
msgid "Checking..."
msgstr "जाँच रहा है..."

#: src/configpage.cpp:171
#, kde-format
msgid "Update check failed: %1"
msgstr "अद्यतन की जाँच विफल: %1"

#: src/configpage.cpp:178
#, kde-format
msgid "Update check failed: no published release found."
msgstr "अद्यतन की जाँच विफल: कोई प्रकाशित रिलीज़ नहीं मिली।"

#: src/configpage.cpp:189
#, kde-format
msgid "Update available: %1 (installed %2). <a href=\"%3\">Release notes</a>"
msgstr "अद्यतन उपलब्ध: %1 (संस्थापित संस्करण: %2)। <a href=\"%3\">रिलीज़ नोट्स</a>"

#: src/configpage.cpp:191
#, kde-format
msgid "Up to date (installed %1)."
msgstr "अद्यतित (संस्थापित संस्करण: %1)।"

#: src/imagepaste.cpp:30
#, kde-format
msgid ""
"Save the document before pasting an image: the image is stored beside it."
msgstr "छवि चिपकाने से पहले दस्तावेज़ सहेजें: छवि दस्तावेज़ के साथ ही सहेजी जाती है।"

#: src/imagepaste.cpp:45
#, kde-format
msgid "Could not save the image to %1"
msgstr "छवि को %1 में सहेजा नहीं जा सका"

