msgstr "Macros matemáticas:"

#: src/configpage.cpp:111
#, kde-format
msgid ""
"The \\newcommand lines written here are available in the formulas of every "
"document."
msgstr ""
"Las líneas \\newcommand escritas aquí están disponibles en las fórmulas de "
"todos los documentos."

