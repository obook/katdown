#: src/configpage.cpp:74
#, kde-format
msgid "GitHub"
msgstr "GitHub"

#: src/configpage.cpp:75
#, kde-format
msgid "Match editor / system theme"
msgstr "Според темата на редактора / системата"

#: src/configpage.cpp:76
#, kde-format
msgid "Style:"
msgstr "Стил:"

#: src/configpage.cpp:79
#, kde-format
